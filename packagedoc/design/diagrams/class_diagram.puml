@startuml
title Overview Class Diagram for Test Result DB Access

left to right direction

' Tools
package "RobotLog2DBTool" {
    class RobotLog2DB
}

package "PyTestLog2DBTool" {
    class PyTestLog2DB
}

' DB Access Layer
package "TestResultDBAccess" {
    class DBAccessInterface <<interface>>
    class DirectDBAccess
    class RestApiDBAccess
    class DBAccessFactory
}

' REST API (part of WebApplication)
package "TestResultWebapp" {
    class RESTAPI
}

' Tool calls Factory
RobotLog2DB ..> DBAccessFactory : create()
PyTestLog2DB ..> DBAccessFactory : create()

' Factory returns interface
DBAccessFactory ..> DBAccessInterface : returns

' DB Access realization
DBAccessInterface <|.. DirectDBAccess
DBAccessInterface <|.. RestApiDBAccess

' REST API calls / implements DB access
RestApiDBAccess --> RESTAPI : HTTP/HTTPS

@enduml
